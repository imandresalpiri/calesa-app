{
  "name": "importadora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/worktree/con-carril.sh next dev",
    "funciones": "bash scripts/worktree/con-carril.sh supabase functions serve",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && pnpm -s test:kit",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/compilar-e2e.sh && E2E_PROD=1 bash scripts/candado.sh test:e2e -- playwright test",
    "test:e2e:completo": "bash scripts/candado.sh test:e2e:completo -- node scripts/e2e-completo.mjs",
    "db:reset": "bash scripts/candado.sh db:reset -- supabase db reset",
    "db:types": "bash scripts/candado.sh db:types -- sh -c 'supabase gen types typescript --local --schema public --schema web > src/shared/types/database.types.ts' && prettier --ignore-path .gitignore --write src/shared/types/database.types.ts",
    "db:diff": "bash scripts/candado.sh db:diff -- supabase db diff -f",
    "db:probar": "node scripts/probar-schema.mjs supabase",
    "db:probar:rapido": "PROBAR_RAPIDO=1 node scripts/probar-schema.mjs supabase",
    "db:medir": "bash scripts/candado.sh db:medir -- node scripts/medir-listado.mjs",
    "db:carreras": "bash scripts/candado.sh db:carreras -- node scripts/carreras.mjs",
    "db:lint": "bash scripts/candado.sh db:lint -- supabase db lint --fail-on error",
    "db:revisar": "bash scripts/candado.sh db:revisar -- bash scripts/db/revisar.sh",
    "db:aplastar": "bash scripts/candado.sh db:aplastar -- bash scripts/db/aplastar.sh",
    "mapa": "bash scripts/mapa.sh",
    "env:check": "tsx scripts/env-check.ts",
    "despliegue:en-seco": "bash scripts/candado.sh despliegue:en-seco -- bash scripts/despliegue/en-seco.sh",
    "email:probar": "tsx scripts/email-probar.ts",
    "preinstall": "npx only-allow pnpm",
    "db:sembrar-volumen": "bash scripts/candado.sh db:sembrar-volumen -- node scripts/sembrar-volumen.mjs",
    "db:medir:volumen": "bash scripts/candado.sh db:medir:volumen -- node scripts/medir-listado.mjs --volumen",
    "test:kit": "node --test scripts/lib/*.test.mjs scripts/proyecto/*.test.mjs scripts/orquestador/*.test.mjs",
    "contrato:generar": "bash scripts/candado.sh contrato:generar -- tsx scripts/contratos/contrato.ts generar",
    "contrato:probar": "bash scripts/candado.sh contrato:probar -- tsx scripts/contratos/contrato.ts probar",
    "contrato:tipos": "tsx scripts/contratos/contrato.ts tipos",
    "contrato:usar": "tsx scripts/contratos/contrato.ts usar"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "konva": "10.11.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.3",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "papaparse": "^5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
