# Configuración del orquestador de este proyecto. Lo carga orquestador.sh con `source`: sintaxis de bash, valores con espacios entre
# comillas. Se versiona: nada de secretos ni de rutas de una máquina. Lo de tu máquina (el tema de ntfy, bajar PARALELO, PATH_EXTRA)
# va en .orquestador/config.local.env, que git ignora y pisa lo de aquí. El repo es el que contiene este archivo.

# --- Quién ---
# El nombre del repo: va en el servicio de systemd (orquestador-<PROYECTO>) y en el título de cada aviso. Vacío: sale del manifiesto
# (`nombre` del repo en .proyecto/proyecto.yaml, <proyecto>-<rol>); se fija aquí sólo en un repo sin manifiesto.
PROYECTO=""

# La cola vive en los issues de este repo con la etiqueta `cola` (README.md › «La cola en los issues»). Con ORQ_SOLO_LOCAL=1 en
# .orquestador/config.local.env, sólo en .orquestador/cola/, como antes (sin issues, sin adopción ni comentarios).
# El repo del kit: lo nombra `kit:<rama>` en un `depende` (un PR integrado del kit).
KIT_GITHUB="imandresalpiri/kit"

# Lo ignorado por git que cada worktree necesita (lo mismo que .worktreeinclude) y lo que Orca comparte por enlace (orca.yaml).
INCLUIR=".env.local .env.demo"
COMPARTIDAS="docs/referencias/cotizador-actual"

# --- Cuánto a la vez ---
# Tareas de este proyecto corriendo en paralelo. Cada una ocupa un carril (a, b o c) con su Supabase en Docker: 3 es el máximo de
# preparar.sh. Si vas a trabajar tú en un carril con Orca a la vez, baja a 2 en config.local.env. El tope de la máquina, entre todos
# sus orquestadores, es otro: TURNOS_MAQUINA en ~/.config/orquestador/maquina.env (lo crea `verificar`).
PARALELO=3

# Cada cuánto revisa la cola y los PR (segundos).
INTERVALO=60

# --- Niveles de modelo ---
# Qué modelo es cada nivel: alias, nunca versiones (una versión envejece sin que nadie lo note). `verificar` dice cuál es hoy.
NIVEL_RAPIDO="haiku"
NIVEL_NORMAL="sonnet"
NIVEL_CAPAZ="opus"
# El nivel de cada sesión (rapido, normal o capaz), si la spec no dice `nivel:` (o `nivel_plan:` para el plan).
NIVEL_EJECUTAR="normal"
EFFORT_EJECUTAR="high"
NIVEL_PLANIFICAR="capaz"
# `high`: con `xhigh` cada plan tardaba de 11 a 27 min dentro del carril y sumaba un cuarto del costo de la tanda.
EFFORT_PLANIFICAR="high"
# Para arreglar un CI rojo: los dos primeros intentos con el modelo de la tarea; desde el tercero, con este nivel.
NIVEL_ARREGLAR_DIFICIL="capaz"
EFFORT_ARREGLAR_DIFICIL="xhigh"

# Modo de permisos de las sesiones que editan. `auto` (un clasificador revisa cada acción; los hooks y el deny de
# .claude/settings.json siguen mandando). Si tu Claude Code no tiene `auto`, pon `acceptEdits`: entonces vale la lista de abajo.
MODO_EJECUTAR="auto"
# Herramientas que se permiten además de las de .claude/settings.json (sólo importan con MODO_EJECUTAR=acceptEdits).
HERRAMIENTAS_EXTRA="Bash(git switch *),Bash(git fetch *),Bash(git merge *),Bash(git push *),Bash(git rev-parse *),Bash(git show *),Bash(git branch *),Bash(git ls-files *),Bash(gh *),Bash(ls *),Bash(cat *),Bash(head *),Bash(tail *),Bash(wc *),Bash(grep *),Bash(rg *),Bash(find *),Bash(jq *),Bash(sed -n *),Bash(sort *),Bash(diff *),Bash(TZ=America/La_Paz date *),Bash(date *)"

# --- Límites ---
# Tiempo máximo de una sesión (formato de `timeout`). Una que se pasa se retoma desde lo commiteado.
TIEMPO_MAX_SESION="5h"
# Tokens de contexto a los que `claude -p` compacta solo (`--autocompact`, de 100000 a 1000000). Con la ventana de 1M casi ninguna sesión
# compactaba y cada turno releía 500k–900k tokens: el 41 % de los turnos de una tanda corrió con más de 300k. Vacío: no se pasa el flag.
# Vale para las sesiones de tarea, retomar, arreglar, el plan y la redacción de un pedido.
AUTOCOMPACT_SESION=300000
# Veces que una tarea puede retomarse (sesión que terminó sin publicar, se cayó o se pasó de tiempo) antes de quedar trabada.
MAX_RETOMAS=3
# Veces que una sesión que terminó sin su línea RESULTADO se sigue en la misma conversación (`claude -p --resume`) antes de retomarla:
# sólo si su salida muestra trabajo en segundo plano sin terminar o un error de la API sin respuesta. No gasta MAX_RETOMAS.
MAX_SEGUIR=2
# Veces que se manda a arreglar un PR por un CI rojo antes de quedar trabada.
MAX_ARREGLOS=4
# Veces que se manda a arreglar un choque con main (lo causa lo que otra tarea integró, no la tarea): cuentan aparte de MAX_ARREGLOS.
MAX_CHOQUES=8
# Veces que una tarea espera a la urgente de un e2e que cae también en main (`RESULTADO: AJENO`): no gastan MAX_ARREGLOS, pero si el spec sigue
# cayendo tras integrarse su urgente, algo no cierra y la tarea se traba.
MAX_AJENOS=3
# Veces que se relanzan sin sesión los jobs caídos por algo ajeno al PR (un e2e que no toca, la máquina del CI) en una misma punta.
# Un bloque de e2e entre lo caído se relanza una sola vez por tarea (sin-sesion.sh › reintentar_ci_ajeno).
REINTENTOS_CI_POR_PUNTA=2
# Suscripción Max/Pro: al llegar al límite del plan, pausa hasta la hora en que se renueva (la que dice la salida de la sesión, más 2 min).
# Sólo si la sesión no la dice, pausa esto (minutos) y vuelve a probar. No gasta reintentos.
PAUSA_POR_LIMITE_MIN=30
# Utilización semanal de la cuenta (0 a 1) desde la que no se lanzan sesiones de plan ni del nivel capaz hasta que la semana se renueve
# (las de arreglo sí). La última utilización vista en cualquier sesión de la máquina. 0 lo apaga.
UMBRAL_USO_SEMANAL=0.95
# Durante esa pausa, cada cuántos minutos pregunta lo mínimo al modelo capaz: si responde, quita la pausa antes de que venza. 0 lo apaga.
PROBAR_PAUSA_MIN=5
# Lugar mínimo libre (%, de inodos y de espacio) en /tmp, el disco del repo y el de las carpetas temporales para lanzar una tarea.
# Por debajo no lanza (las que corren siguen), avisa una vez y sigue solo cuando se libera.
MIN_LIBRE_PCT=5
# Una tarea trabada ¿sigue bloqueando a las que comparten su área (llave de conflicto)? «si»: la que comparte su área espera a que se
# destrabe (con «no», una tarea que reusaba lo de la trabada arrancó sin eso, lo copió a mano y chocó al integrar).
TRABADA_RETIENE_LLAVES="si"

# --- Archivos temporales ---
# La carpeta temporal de cada tarea (su TMPDIR) cuelga de aquí: se vacía al empezar cada corrida y se borra al integrarse. Va en el
# disco y no en /tmp (un tmpfs con tope de archivos que comparten todos los proyectos). Ruta corta: hay herramientas que abren sockets
# en TMPDIR y Linux no acepta rutas de socket de más de 108 caracteres. Vacío: ${XDG_CACHE_HOME:-$HOME/.cache}/orquestador/<PROYECTO>.
TMP_TAREAS=""

# --- Lo que entra solo a la cola ---
# Una vez al mes (UTC), si no hay un issue `deps` de ese mes ni uno abierto de antes, crea la tarea de dependencias desde
# plantillas/dependencias.md (`permite: dependencias`: pnpm update dentro de los rangos y pnpm dedupe). «no» la apaga.
DEPS_MENSUAL="si"
# Una vez por semana (UTC), si .kit/version quedó atrás del main del kit (KIT_GITHUB) en algún archivo de flujo y no hay un issue `kit`
# abierto, crea la tarea de traer el flujo del kit desde plantillas/traer-flujo-del-kit.md (kit.sh). «no» la apaga.
KIT_SEMANAL="si"
# Al integrar un PR que toca flujo (scripts/kit/flujo.txt) o suma una lección `(kit)` o `(semilla)`, crea en el kit un issue `cola`
# «traer de <repo> el PR #<n>» con el token de la cuenta dueña del kit (kit.sh). «no» lo apaga.
KIT_AVISAR="si"
# Un issue con la etiqueta `pedido` (texto libre, desde el celular) lo redacta como spec una sesión en modo plan (pedidos.sh), una a la
# vez y después de las tareas: su nivel, su effort y su tiempo máximo (formato de `timeout`).
NIVEL_REDACTAR="capaz"
EFFORT_REDACTAR="high"
TIEMPO_MAX_REDACCION="45m"
# Cuando la cola queda quieta (nada corriendo ni lanzable, ninguna trabada) y desde el último cierre se integraron al menos
# CIERRE_MIN_TAREAS tareas (sin contar las que entran solas ni las del cierre), verifica main con el e2e de escritorio y encola el cierre
# de la tanda desde plantillas/cerrar-tanda.md: docs aplastados, lo que sobra fuera y la retro con datos (cierre-tanda.sh). «no» lo apaga.
CIERRE_TANDA="si"
CIERRE_MIN_TAREAS=3
# Con main en más de una migración, el cierre encola antes el aplastado (plantillas/aplastar-migraciones.md, su propio PR) y depende de
# él: cada tanda termina con una sola migración. «no» lo apaga.
CIERRE_APLASTAR="si"

# --- GitHub como la app ---
# El orquestador y sus sesiones escriben en GitHub como la app del orquestador (README.md › «Como la app de GitHub»): token de
# instalación de una hora que pide token-app.sh con la clave de la app. Vacío = la sesión de gh de la persona (como antes). Los ids no
# son secretos; la clave sí: nunca en el repo, ni en un log, ni impresa.
APP_ID="5855024"
APP_INSTALACION="184174354"
# El login de la app (`<slug>[bot]`): con él se reconoce el issue que abre (github.sh › identidad_app). Vacío = el de la caché del token.
APP_LOGIN="imandresalpiri-orquestador[bot]"
APP_CLAVE="$HOME/.config/orquestador/app.pem"

# --- Avisos (ntfy.sh) ---
# Un tema largo y difícil de adivinar: quien lo sepa lee tus avisos. NO se escribe aquí (este archivo se versiona): va en
# .orquestador/config.local.env como NTFY_TEMA="…". Vacío: no manda avisos (quedan en .orquestador/estado/orquestador.log).
# Para crear uno: echo "NTFY_TEMA=\"$PROYECTO-$(openssl rand -hex 8)\"" >> .orquestador/config.local.env
NTFY_TEMA=""
NTFY_SERVIDOR="https://ntfy.sh"

# --- Entorno ---
# Rutas que el servicio de systemd no hereda de tu terminal (claude, pnpm, node). nvm se carga solo si existe ~/.nvm.
PATH_EXTRA="$HOME/.local/bin:$HOME/.local/share/pnpm:$HOME/.bun/bin"
