{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx supabase *)",
      "Bash(bash scripts/*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(npm i -g *)",
      "Bash(npm install -g *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git branch -D*)",
      "Bash(gh workflow run*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(supabase secrets*)",
      "Bash(npx supabase secrets*)",
      "Bash(npx next upgrade*)",
      "Bash(pnpm next upgrade*)",
      "Bash(pnpm exec next upgrade*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.demo)",
      "Read(~/.config/orquestador/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-peligrosos.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-archivo.sh",
            "timeout": 30,
            "statusMessage": "Linting el archivo…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-al-terminar.sh",
            "timeout": 120,
            "statusMessage": "Verificando antes de terminar (mapa, typecheck y lo tocado)…"
          }
        ]
      }
    ]
  }
}
